mach create "ast2600"
machine LoadPlatformDescription @platforms/boards/ast2600/ast2600-evb.repl
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x0
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x60000000
sysbus SilenceRange <0x1E630000 0xC4>
sysbus SilenceRange <0x30000000 0x10000000>
sysbus SilenceRange <0x1E631000 0xC4>
sysbus SilenceRange <0x50000000 0x10000000>
sysbus SilenceRange <0x1E650000 0x20>
sysbus SilenceRange <0x1E740000 0x10000>
sysbus SilenceRange <0x1E750000 0x10000>
sysbus SilenceRange <0x1E6A0000 0x1000>
sysbus SilenceRange <0x1E6A3000 0x1000>
sysbus SilenceRange <0x1E700000 0x1000>

logLevel 3
uart5 CreateFileBackend @/tmp/openbmc-uart-check.txt true

emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD

uart5 WriteLine "setenv bootargs console=ttyS4,115200n8 earlycon=uart8250,mmio32,0x1e784000,115200n8"
emulation RunFor "1"
uart5 WriteLine "boot"

emulation RunFor "30"

# Read UART registers: LSR at offset 0x14 (0x5 * 4 for wide regs), IER at 0x04, FCR/IIR at 0x08
# LSR bit 5 = THRE, bit 6 = TEMT
sysbus ReadByte 0x1E784014
sysbus ReadByte 0x1E784004
sysbus ReadByte 0x1E784008

# Check CPU state
cpu0 PC
cpu0 ExecutedInstructions

quit
