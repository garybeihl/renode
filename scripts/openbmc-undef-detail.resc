mach create "ast2600"
machine LoadPlatformDescription @platforms/boards/ast2600/ast2600-evb.repl
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x0
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x20000000
sysbus SilenceRange <0x1E630000 0xC4>
sysbus SilenceRange <0x30000000 0x10000000>
sysbus SilenceRange <0x1E631000 0xC4>
sysbus SilenceRange <0x50000000 0x10000000>
sysbus SilenceRange <0x1E650000 0x20>
sysbus SilenceRange <0x1E740000 0x10000>
sysbus SilenceRange <0x1E750000 0x10000>
sysbus SilenceRange <0x1E6A0000 0x1000>
sysbus SilenceRange <0x1E6A3000 0x1000>
sysbus SilenceRange <0x1E700000 0x1000>

logLevel 3
uart5 CreateFileBackend @/tmp/openbmc-undef-detail.txt true

# Autoboot interrupt
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD

uart5 WriteLine "setenv bootargs console=ttyS4,115200n8 earlycon=uart8250,mmio32,0x1e784000,115200n8 nosmp maxcpus=1 panic=-1"
emulation RunFor "1"
uart5 WriteLine "boot"

# Run 28s to get past earlycon
emulation RunFor "28"

# Set breakpoint at __und_svc entry (0x80100c40)
# When we hit it, log the LR (R14) which contains the faulting PC+4
# Also log SPSR to check Thumb bit
cpu0 AddHook 0xffff11a4 "lr = self.GetRegisterUnsafe(14); self.Log(LogLevel.Error, 'UNDEF: LR=0x{0:X8}, faulting_insn_addr=0x{1:X8}', lr, lr-4); self.RemoveAllHooks()"

# Run a tiny bit to hit the hook
emulation RunFor "0.001"

# Now we should have stopped at the first vector_und entry
cpu0 PC

# Read the faulting instruction bytes — need to read from the virtual address
# LR-4 = 0x80100c50 based on earlier
sysbus ReadDoubleWord 0x80100c50
sysbus ReadDoubleWord 0x80100c4c
sysbus ReadDoubleWord 0x80100c48
sysbus ReadDoubleWord 0x80100c44
sysbus ReadDoubleWord 0x80100c40

# Also read the vector_und entry to see what ORIGINAL fault was
# The und mode stack would have the saved LR from the FIRST fault
# Read some nearby addresses for context
sysbus ReadDoubleWord 0x80100c54
sysbus ReadDoubleWord 0x80100c58

# Check CPSR
cpu0 CPSR

quit
