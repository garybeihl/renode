mach create "ast2600"
machine LoadPlatformDescription @platforms/boards/ast2600/ast2600-evb.repl
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x0
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x60000000
sysbus SilenceRange <0x1E630000 0xC4>
sysbus SilenceRange <0x30000000 0x10000000>
sysbus SilenceRange <0x1E631000 0xC4>
sysbus SilenceRange <0x50000000 0x10000000>
sysbus SilenceRange <0x1E650000 0x20>
sysbus SilenceRange <0x1E740000 0x10000>
sysbus SilenceRange <0x1E750000 0x10000>
sysbus SilenceRange <0x1E6A0000 0x1000>
sysbus SilenceRange <0x1E6A3000 0x1000>
sysbus SilenceRange <0x1E700000 0x1000>

logLevel 3
uart5 CreateFileBackend @/tmp/openbmc-watchpoint-und.txt true

# Autoboot interrupt
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD

uart5 WriteLine "setenv bootargs console=ttyS4,115200n8 earlycon=uart8250,mmio32,0x1e784000,115200n8 nosmp maxcpus=1 panic=-1"
emulation RunFor "1"
uart5 WriteLine "boot"

# Run 20s - U-Boot loads kernel and starts booting
emulation RunFor "20"

# Verify __und_svc code is still intact at this point
# Expected first instruction: 0xE24DD050 (sub sp, sp, #80)
sysbus ReadDoubleWord 0x80100c40

# Add write watchpoint on __und_svc region (0x80100c40)
# This will fire when ANYTHING writes to this address
# The handler logs the CPU PC and the value being written
sysbus AddWatchpointHook 0x80100c40 DoubleWord Write "sysbus.Log(LogLevel.Error, 'WATCHPOINT WRITE to 0x80100c40: value=0x{0:X8} from cpu PC=0x{1:X8}', value, cpu.PC)"
sysbus AddWatchpointHook 0x80100c44 DoubleWord Write "sysbus.Log(LogLevel.Error, 'WATCHPOINT WRITE to 0x80100c44: value=0x{0:X8} from cpu PC=0x{1:X8}', value, cpu.PC)"
sysbus AddWatchpointHook 0x80100c48 DoubleWord Write "sysbus.Log(LogLevel.Error, 'WATCHPOINT WRITE to 0x80100c48: value=0x{0:X8} from cpu PC=0x{1:X8}', value, cpu.PC)"
sysbus AddWatchpointHook 0x80100c4c DoubleWord Write "sysbus.Log(LogLevel.Error, 'WATCHPOINT WRITE to 0x80100c4c: value=0x{0:X8} from cpu PC=0x{1:X8}', value, cpu.PC)"
sysbus AddWatchpointHook 0x80100c50 DoubleWord Write "sysbus.Log(LogLevel.Error, 'WATCHPOINT WRITE to 0x80100c50: value=0x{0:X8} from cpu PC=0x{1:X8}', value, cpu.PC)"
sysbus AddWatchpointHook 0x80100c54 DoubleWord Write "sysbus.Log(LogLevel.Error, 'WATCHPOINT WRITE to 0x80100c54: value=0x{0:X8} from cpu PC=0x{1:X8}', value, cpu.PC)"

# Continue boot - the corruption should happen during the next ~10s
emulation RunFor "10"

# Check if the code was corrupted
sysbus ReadDoubleWord 0x80100c40
sysbus ReadDoubleWord 0x80100c44
sysbus ReadDoubleWord 0x80100c48
sysbus ReadDoubleWord 0x80100c4c
sysbus ReadDoubleWord 0x80100c50
sysbus ReadDoubleWord 0x80100c54

quit
