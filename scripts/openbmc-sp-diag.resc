mach create "ast2600"
machine LoadPlatformDescription @platforms/boards/ast2600/ast2600-evb.repl
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x0
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x60000000
sysbus SilenceRange <0x1E630000 0xC4>
sysbus SilenceRange <0x30000000 0x10000000>
sysbus SilenceRange <0x1E631000 0xC4>
sysbus SilenceRange <0x50000000 0x10000000>
sysbus SilenceRange <0x1E650000 0x20>
sysbus SilenceRange <0x1E740000 0x10000>
sysbus SilenceRange <0x1E750000 0x10000>
sysbus SilenceRange <0x1E6A0000 0x1000>
sysbus SilenceRange <0x1E6A3000 0x1000>
sysbus SilenceRange <0x1E700000 0x1000>

# Log level 2 = WARNING (show our SVC_SP diagnostics)
logLevel 2
uart5 CreateFileBackend @/tmp/openbmc-sp-diag.txt true

# Autoboot interrupt
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD

uart5 WriteLine "setenv bootargs console=ttyS4,115200n8 earlycon=uart8250,mmio32,0x1e784000,115200n8 nosmp maxcpus=1 panic=-1"
emulation RunFor "1"
uart5 WriteLine "boot"

# Run to just before corruption (t=28s from start, ~16s after boot cmd)
emulation RunFor "16"

# Check: is __und_svc still intact?
sysbus ReadDoubleWord 0x80100c40

# Continue in small steps - corruption happens between 28.0 and 28.5
emulation RunFor "0.1"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.1"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.1"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.1"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.1"
sysbus ReadDoubleWord 0x80100c40

# If still intact at 28.5, continue
emulation RunFor "0.1"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.1"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.1"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.1"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.1"
sysbus ReadDoubleWord 0x80100c40

# 29s now - check more
emulation RunFor "0.5"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.5"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.5"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.5"
sysbus ReadDoubleWord 0x80100c40

quit
