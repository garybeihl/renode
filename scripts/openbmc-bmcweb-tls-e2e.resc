mach create "ast2600"
machine LoadPlatformDescription @platforms/boards/ast2600/ast2600-evb.repl

sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x0
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x60000000
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x88000000

sysbus SilenceRange <0x1E630000 0xC4>
sysbus SilenceRange <0x30000000 0x10000000>
sysbus SilenceRange <0x1E631000 0xC4>
sysbus SilenceRange <0x50000000 0x10000000>
sysbus SilenceRange <0x1E740000 0x10000>
sysbus SilenceRange <0x1E750000 0x10000>
sysbus SilenceRange <0x1E6A0000 0x1000>
sysbus SilenceRange <0x1E6A3000 0x1000>
sysbus SilenceRange <0x1E700000 0x1000>

logLevel 2

# User-mode networking (like QEMU slirp) — no sudo, no TAP
# Guest gets 10.0.2.15 via DHCP; gateway 10.0.2.2 = host
emulation CreateUserNetwork "net" "10.0.2.2" "10.0.2.15"
emulation CreateSwitch "sw1"
connector Connect sysbus.eth1 sw1
connector Connect net sw1

# Port forward: host 127.0.0.1:2443 → guest 10.0.2.15:443 (bmcweb)
net AddPortForward "127.0.0.1" 2443 "10.0.2.15" 443
# Port forward: host 127.0.0.1:2222 → guest 10.0.2.15:22 (ssh, for test harness)
net AddPortForward "127.0.0.1" 2222 "10.0.2.15" 22
net EnableNat

# MCTP serial PTY (for pldm, not needed for TLS test but harmless)
emulation CreateUartPtyTerminal "mctp_serial" "/tmp/renode-mctp-pty" true
connector Connect uart1 mctp_serial

# Console log capture
uart5 CreateFileBackend @/tmp/openbmc-tls-e2e.txt true

# Autoboot interrupt
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD

uart5 WriteLine "setenv bootargs console=ttyS4,115200n8 earlycon=uart8250,mmio32,0x1e784000,115200n8 nosmp maxcpus=1 panic=-1"
emulation RunFor "1"
uart5 WriteLine "bootm 88100000"

# Boot wait (kernel + systemd)
emulation RunFor "300"

# Auto-login
uart5 WriteLine "root"
emulation RunFor "10"
uart5 WriteLine "0penBmc"
emulation RunFor "10"

# Guest should get 10.0.2.15 via DHCP on eth0
# Add /etc/hosts for the test hostnames pointing at gateway (= host)
uart5 WriteLine "echo '10.0.2.2 good.example.com evil.example.com' >> /etc/hosts"
emulation RunFor "2"

# Clear DNS so resolution uses /etc/hosts (no DNS server in user-mode network)
uart5 WriteLine "echo > /etc/resolv.conf"
emulation RunFor "2"

# Check IP
uart5 WriteLine "ip addr show eth0"
emulation RunFor "2"

uart5 WriteLine "echo NETWORK_READY"
emulation RunFor "2"

# Leave the emulation running so bmcweb can serve test requests
start
