mach create "ast2600"
machine LoadPlatformDescription @platforms/boards/ast2600/ast2600-evb.repl
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x0
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x20000000
sysbus SilenceRange <0x1E630000 0xC4>
sysbus SilenceRange <0x30000000 0x10000000>
sysbus SilenceRange <0x1E631000 0xC4>
sysbus SilenceRange <0x50000000 0x10000000>
sysbus SilenceRange <0x1E650000 0x20>
sysbus SilenceRange <0x1E740000 0x10000>
sysbus SilenceRange <0x1E750000 0x10000>
sysbus SilenceRange <0x1E6A0000 0x1000>
sysbus SilenceRange <0x1E6A3000 0x1000>
sysbus SilenceRange <0x1E700000 0x1000>

logLevel 3
uart5 CreateFileBackend @/tmp/openbmc-undef-catch.txt true

# Autoboot interrupt
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD

uart5 WriteLine "setenv bootargs console=ttyS4,115200n8 earlycon=uart8250,mmio32,0x1e784000,115200n8 nosmp maxcpus=1 panic=-1"
emulation RunFor "1"
uart5 WriteLine "boot"

# Run 28s with quiet logging (past earlycon output, before the stall point)
emulation RunFor "28"

# Enable WARNING level logging to catch CPU warnings about undefined instructions
logLevel 1 cpu0

# Run a brief interval to capture the first undefined instruction
emulation RunFor "0.01"

# Disable verbose logging and sample PC
logLevel 3 cpu0
cpu0 PC

quit
