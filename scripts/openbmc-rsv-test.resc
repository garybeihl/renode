mach create "ast2600"
machine LoadPlatformDescription @platforms/boards/ast2600/ast2600-evb.repl

# Create user-mode network with DHCP (gateway 10.0.2.2, guest 10.0.2.15)
emulation CreateNetworkServer "net" "10.0.2.2"
net StartDHCP "10.0.2.15"

# Port forward: host 2443 → guest 443 (HTTPS/bmcweb)
net AddPortForward "127.0.0.1" 2443 "10.0.2.15" 443

# Create virtual switch and connect network + guest eth1
emulation CreateSwitch "switch"
connector Connect net switch
connector Connect sysbus.eth1 switch

# Load firmware
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x0
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x60000000
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x88000000

sysbus SilenceRange <0x1E630000 0xC4>
sysbus SilenceRange <0x30000000 0x10000000>
sysbus SilenceRange <0x1E631000 0xC4>
sysbus SilenceRange <0x50000000 0x10000000>
sysbus SilenceRange <0x1E740000 0x10000>
sysbus SilenceRange <0x1E750000 0x10000>
sysbus SilenceRange <0x1E6A0000 0x1000>
sysbus SilenceRange <0x1E6A3000 0x1000>
sysbus SilenceRange <0x1E700000 0x1000>

logLevel 2
uart5 CreateFileBackend @/tmp/openbmc-rsv-test.txt true

# Autoboot interrupt
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD

uart5 WriteLine "setenv bootargs console=ttyS4,115200n8 earlycon=uart8250,mmio32,0x1e784000,115200n8 nosmp maxcpus=1 panic=-1"
emulation RunFor "1"
# Boot from DRAM copy
uart5 WriteLine "bootm 88100000"

# Wait for full boot (kernel + systemd + service startup)
# The FTGMAC100/MDIO emulation reports link up via PHYSR register,
# so phylib detects link and systemd-networkd configures eth0 via DHCP.
emulation RunFor "240"

# Login
uart5 WriteLine ""
emulation RunFor "3"
uart5 WriteLine ""
emulation RunFor "3"
uart5 WriteLine "root"
emulation RunFor "10"
uart5 WriteLine "0penBmc"
emulation RunFor "15"

# Verify networking (should already be configured by systemd-networkd + DHCP)
uart5 WriteLine "ip addr show eth0"
emulation RunFor "3"
uart5 WriteLine "ip route show"
emulation RunFor "3"

# If DHCP didn't assign 10.0.2.15, configure manually
uart5 WriteLine "ip addr show eth0 | grep -q 10.0.2.15 || { ip addr add 10.0.2.15/24 dev eth0; ip route add default via 10.0.2.2; echo 'Manual IP configured'; }"
emulation RunFor "5"

# Start continuous execution so host can connect via port forwarding
# Run RSV from host:
#   source ~/claude/rsv-venv/bin/activate
#   rf_service_validator --auth Session -i https://127.0.0.1:2443 -u root -p 0penBmc --no_cert_check
start
