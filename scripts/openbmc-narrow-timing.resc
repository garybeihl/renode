mach create "ast2600"
machine LoadPlatformDescription @platforms/boards/ast2600/ast2600-evb.repl
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x0
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x20000000
sysbus SilenceRange <0x1E630000 0xC4>
sysbus SilenceRange <0x30000000 0x10000000>
sysbus SilenceRange <0x1E631000 0xC4>
sysbus SilenceRange <0x50000000 0x10000000>
sysbus SilenceRange <0x1E650000 0x20>
sysbus SilenceRange <0x1E740000 0x10000>
sysbus SilenceRange <0x1E750000 0x10000>
sysbus SilenceRange <0x1E6A0000 0x1000>
sysbus SilenceRange <0x1E6A3000 0x1000>
sysbus SilenceRange <0x1E700000 0x1000>

logLevel 3
uart5 CreateFileBackend @/tmp/openbmc-narrow-timing.txt true

# Autoboot interrupt (10s)
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD

uart5 WriteLine "setenv bootargs console=ttyS4,115200n8 earlycon=uart8250,mmio32,0x1e784000,115200n8 nosmp maxcpus=1 panic=-1"
emulation RunFor "1"
uart5 WriteLine "boot"

# Skip to 26s (we know it's intact until then)
emulation RunFor "15"

# Fine-grained checks: every 0.2s from 26s to 28s
emulation RunFor "0.2"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.2"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.2"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.2"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.2"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.2"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.2"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.2"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.2"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.2"
sysbus ReadDoubleWord 0x80100c40

# If still intact, continue with more checks
emulation RunFor "0.5"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.5"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.5"
sysbus ReadDoubleWord 0x80100c40
emulation RunFor "0.5"
sysbus ReadDoubleWord 0x80100c40

# Once corruption found, dump wider region
sysbus ReadDoubleWord 0x80100c00
sysbus ReadDoubleWord 0x80100c04
sysbus ReadDoubleWord 0x80100c08
sysbus ReadDoubleWord 0x80100c0c
sysbus ReadDoubleWord 0x80100c10
sysbus ReadDoubleWord 0x80100c14
sysbus ReadDoubleWord 0x80100c18
sysbus ReadDoubleWord 0x80100c1c
sysbus ReadDoubleWord 0x80100c20
sysbus ReadDoubleWord 0x80100c24
sysbus ReadDoubleWord 0x80100c28
sysbus ReadDoubleWord 0x80100c2c
sysbus ReadDoubleWord 0x80100c30
sysbus ReadDoubleWord 0x80100c34
sysbus ReadDoubleWord 0x80100c38
sysbus ReadDoubleWord 0x80100c3c
sysbus ReadDoubleWord 0x80100c40
sysbus ReadDoubleWord 0x80100c44
sysbus ReadDoubleWord 0x80100c48
sysbus ReadDoubleWord 0x80100c4c
sysbus ReadDoubleWord 0x80100c50
sysbus ReadDoubleWord 0x80100c54
sysbus ReadDoubleWord 0x80100c58
sysbus ReadDoubleWord 0x80100c5c
sysbus ReadDoubleWord 0x80100c60
sysbus ReadDoubleWord 0x80100c64
sysbus ReadDoubleWord 0x80100c68
sysbus ReadDoubleWord 0x80100c6c
sysbus ReadDoubleWord 0x80100c70
sysbus ReadDoubleWord 0x80100c74
sysbus ReadDoubleWord 0x80100c78
sysbus ReadDoubleWord 0x80100c7c

# Also check PC and SP
cpu0 PC
cpu0 GetRegisterUnsafe 13

quit
