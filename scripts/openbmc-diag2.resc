mach create "ast2600"
machine LoadPlatformDescription @platforms/boards/ast2600/ast2600-evb.repl
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x0
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x60000000
sysbus SilenceRange <0x1E630000 0xC4>
sysbus SilenceRange <0x30000000 0x10000000>
sysbus SilenceRange <0x1E631000 0xC4>
sysbus SilenceRange <0x50000000 0x10000000>
sysbus SilenceRange <0x1E650000 0x20>
sysbus SilenceRange <0x1E740000 0x10000>
sysbus SilenceRange <0x1E750000 0x10000>
sysbus SilenceRange <0x1E6A0000 0x1000>
sysbus SilenceRange <0x1E6A3000 0x1000>
sysbus SilenceRange <0x1E700000 0x1000>

logLevel 3
uart5 CreateFileBackend @/tmp/openbmc-diag2.txt true

# Autoboot interrupt
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD

uart5 WriteLine "setenv bootargs console=ttyS4,115200n8 earlycon=uart8250,mmio32,0x1e784000,115200n8 nosmp maxcpus=1 panic=-1"
emulation RunFor "1"
uart5 WriteLine "boot"

# Run to t=27s (just before the cascade starts around t=28)
emulation RunFor "15"

# Check __und_svc is still intact
sysbus ReadDoubleWord 0x80100c40

# Check instruction at search_extable (0x80a0f274) - should be push {lr} = 0xe52de004
sysbus ReadDoubleWord 0x80a0f274
sysbus ReadDoubleWord 0x80a0f278
sysbus ReadDoubleWord 0x80a0f27c
sysbus ReadDoubleWord 0x80a0f280

# Check instruction at _raw_spin_unlock_irqrestore (0x80a42534)
sysbus ReadDoubleWord 0x80a42534
sysbus ReadDoubleWord 0x80a42538
sysbus ReadDoubleWord 0x80a4253c
sysbus ReadDoubleWord 0x80a42540
sysbus ReadDoubleWord 0x80a42544
sysbus ReadDoubleWord 0x80a42548

# Now advance past the crash point
emulation RunFor "2"

# Check if __und_svc is now corrupted
sysbus ReadDoubleWord 0x80100c40

# Check what's at search_extable now
sysbus ReadDoubleWord 0x80a0f274
sysbus ReadDoubleWord 0x80a0f278

# Check what's at _raw_spin_unlock_irqrestore now
sysbus ReadDoubleWord 0x80a42534
sysbus ReadDoubleWord 0x80a42538
sysbus ReadDoubleWord 0x80a4253c

quit
