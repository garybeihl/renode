mach create "ast2600"
machine LoadPlatformDescription @platforms/boards/ast2600/ast2600-evb.repl

# Create user-mode network with DHCP (gateway 10.0.2.2, guest 10.0.2.15)
emulation CreateNetworkServer "net" "10.0.2.2"
net StartDHCP "10.0.2.15"

# Port forward: host 2443 → guest 443 (HTTPS/bmcweb)
net AddPortForward "127.0.0.1" 2443 "10.0.2.15" 443

# Create virtual switch and connect network + guest eth1
emulation CreateSwitch "switch"
connector Connect net switch
connector Connect sysbus.eth1 switch

# Attach SPDM responder device to uart1 (MCTP serial)
emulation CreateSpdmResponderDevice "spdm_dev" @spdm-test-scenario.json
connector Connect uart1 spdm_dev
logLevel -1 spdm_dev

# Load firmware
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x0
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x60000000
sysbus LoadBinary @tests/peripherals/Aspeed/firmware/openbmc-image.bin 0x88000000

sysbus SilenceRange <0x1E630000 0xC4>
sysbus SilenceRange <0x30000000 0x10000000>
sysbus SilenceRange <0x1E631000 0xC4>
sysbus SilenceRange <0x50000000 0x10000000>
sysbus SilenceRange <0x1E740000 0x10000>
sysbus SilenceRange <0x1E750000 0x10000>
sysbus SilenceRange <0x1E6A0000 0x1000>
sysbus SilenceRange <0x1E6A3000 0x1000>
sysbus SilenceRange <0x1E700000 0x1000>

# Enable VFP so OpenSSL ECDSA-P256 works in spdmd
cpu0 FpuEnabled true

logLevel 2
uart5 CreateFileBackend @/tmp/openbmc-rsv-spdm.txt true

# Autoboot interrupt
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD
emulation RunFor "0.5"
uart5 WriteChar 0xD

uart5 WriteLine "setenv bootargs console=ttyS4,115200n8 earlycon=uart8250,mmio32,0x1e784000,115200n8 nosmp maxcpus=1 panic=-1"
emulation RunFor "1"
uart5 WriteLine "bootm 88100000"

# Wait for full boot
emulation RunFor "300"

# Login
uart5 WriteLine ""
emulation RunFor "3"
uart5 WriteLine ""
emulation RunFor "3"
uart5 WriteLine "root"
emulation RunFor "10"
uart5 WriteLine "0penBmc"
emulation RunFor "15"

# Configure networking (fallback if DHCP didn't assign)
uart5 WriteLine "ip addr show eth0 | grep -q 10.0.2.15 || { ip addr add 10.0.2.15/24 dev eth0; ip route add default via 10.0.2.2; }"
emulation RunFor "5"

# Set up MCTP serial link on /dev/ttyS0 with local EID 8, remote EID 20
uart5 WriteLine "nohup mctp link serial /dev/ttyS0 &"
emulation RunFor "3"
uart5 WriteLine "mctp link set mctpserial0 up"
emulation RunFor "1"
uart5 WriteLine "mctp addr add 8 dev mctpserial0"
emulation RunFor "1"
uart5 WriteLine "mctp route add 20 via mctpserial0"
emulation RunFor "1"

# Assign endpoint using shell variables (keeps busctl line short for UART)
uart5 WriteLine "S=au.com.codeconstruct.MCTP1"
emulation RunFor "1"
uart5 WriteLine "P=/au/com/codeconstruct/mctp1/interfaces/mctpserial0"
emulation RunFor "1"
uart5 WriteLine "I=au.com.codeconstruct.MCTP.BusOwner1"
emulation RunFor "1"
uart5 WriteLine "busctl call $S $P $I AssignEndpointStatic ayy 0 20"
emulation RunFor "15"

# Restart spdmd to discover the endpoint and perform attestation
uart5 WriteLine "systemctl restart spdmd"
emulation RunFor "45"

# Verify spdmd is running and attestation completed
uart5 WriteLine "systemctl is-active spdmd && echo SPDMD_OK || echo SPDMD_FAIL"
emulation RunFor "3"
uart5 WriteLine "journalctl -u spdmd --no-pager | tail -n 10"
emulation RunFor "5"

# Check ComponentIntegrity D-Bus objects exist
uart5 WriteLine "busctl tree xyz.openbmc_project.SPDM 2>/dev/null | head -n 10"
emulation RunFor "5"

# Start continuous execution — host can now run RSV
# RSV: source ~/claude/rsv-venv/bin/activate && PYTHONHTTPSVERIFY=0 REQUESTS_CA_BUNDLE="" rf_service_validator --authtype Session --rhost https://127.0.0.1:2443 --user root --password 0penBmc --logdir /tmp/rsv-spdm
start
