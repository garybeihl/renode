python "print('\\n=== TEST 6: SPDM GET_DIGESTS ===')"
python "test_spdm_get_digests()"
emulation RunFor "0:0:0.001"
python "check_spdm_get_digests(); print(_last_result); assert _last_result.startswith('PASS'), _last_result"

# === TEST 7: SPDM GET_CERTIFICATE ===
python "print('\\n=== TEST 7: SPDM GET_CERTIFICATE ===')"
python "test_spdm_get_certificate()"
emulation RunFor "0:0:0.001"
python "check_spdm_get_certificate(); print(_last_result); assert _last_result.startswith('PASS'), _last_result"

# === TEST 8: SPDM CHALLENGE ===
python "print('\\n=== TEST 8: SPDM CHALLENGE ===')"
python "test_spdm_challenge()"
emulation RunFor "0:0:0.001"
python "check_spdm_challenge(); print(_last_result); assert _last_result.startswith('PASS'), _last_result"

# === TEST 9: SPDM GET_MEASUREMENTS (count only) ===
python "print('\\n=== TEST 9: SPDM GET_MEASUREMENTS (count) ===')"
python "test_spdm_get_measurements_count()"
emulation RunFor "0:0:0.001"
python "check_spdm_get_measurements_count(); print(_last_result); assert _last_result.startswith('PASS'), _last_result"

# === TEST 10: SPDM GET_MEASUREMENTS (all, signed) ===
python "print('\\n=== TEST 10: SPDM GET_MEASUREMENTS (all, signed) ===')"
python "test_spdm_get_measurements_all_signed()"
emulation RunFor "0:0:0.001"
python "check_spdm_get_measurements_all_signed(); print(_last_result); assert _last_result.startswith('PASS'), _last_result"

python "print('\\n=== ALL 10 TESTS PASSED ===')"
