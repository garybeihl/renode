sysbus WriteByte 0x1e783000 0xD7
sysbus WriteByte 0x1e783000 0x98
sysbus WriteByte 0x1e783000 0x7E

log "=== Test 3: GetTID - check log for 'GetTID: responding TID=1' ==="

