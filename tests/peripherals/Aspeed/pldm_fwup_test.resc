:name: PldmFirmwareDevice Firmware Update State Machine Test
:description: Tests RequestUpdate → PassComponentTable → UpdateComponent → Download → Verify → Apply → ActivateFirmware

mach create "test"
machine LoadPlatformDescriptionFromString "uart1: UART.NS16550 @ sysbus 0x1e783000"
emulation CreatePldmFirmwareDevice "pldm_fd"
connector Connect uart1 pldm_fd

logLevel -1 pldm_fd

log "=== FWUP Test: RequestUpdate ==="
